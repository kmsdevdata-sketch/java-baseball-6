<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- 테스트 메서드는 한글과 언더스코어를 사용할 수 있도록 허용한다. -->
    <suppress
            files="[\\/]src[\\/]test[\\/]java[\\/].*"
            checks="MethodName"/>

    <!-- 제공된 테스트 코드는 수정 대상이 아니므로 메서드 길이에서 제외한다. -->
    <suppress
            files="[\\/]src[\\/]test[\\/]java[\\/].*ApplicationTest\.java"
            checks="MethodLength"/>
</suppressions>